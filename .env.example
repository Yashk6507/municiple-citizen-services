# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Secret (change in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Default accounts created on first start (change before going live)
ADMIN_EMAIL=admin@municipal.local
ADMIN_PASSWORD=Admin@123
# Service-desk officer, so complaints can be assigned and email alerts tested
OFFICER_EMAIL=officer@municipal.local
OFFICER_PASSWORD=Officer@123

# Brevo email alerts (leave BREVO_API_KEY blank to keep email disabled)
# Create an API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Municipal Citizen Services
# Shared secret for the inbound webhook (/api/email/inbound?token=...)
BREVO_INBOUND_SECRET=
# Municipal mailbox that citizens reply to
SUPPORT_INBOX=
# Public base URL used in alert email links, e.g. http://localhost:4000
PUBLIC_BASE_URL=http://localhost:4000

# Map tiles are proxied through the portal (/api/map/tiles) so the browser never
# floods a public tile server. Point these at your own tile server if you have one.
TILE_UPSTREAM_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_FALLBACK_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
TILE_CONCURRENCY=2
TILE_CACHE_SIZE=800

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
